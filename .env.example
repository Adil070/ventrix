# ========================
# Application
# ========================
NODE_ENV=development
APP_NAME="Ventrix"
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
API_PORT=8000

# ========================
# Database
# ========================
POSTGRES_USER=ventrix
POSTGRES_PASSWORD=ventrix_secret
POSTGRES_DB=ventrix_db
DATABASE_URL=postgresql://ventrix:ventrix_secret@localhost:5432/ventrix_db

# ========================
# Redis
# ========================
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379

# ========================
# JWT Authentication
# ========================
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ========================
# Scheduled jobs
# ========================
# Shared with the scheduler (.github/workflows/sales-report.yml secret CRON_SECRET), min 32 chars.
# Generate: openssl rand -hex 32. Leave unset to disable /api/v1/internal/*.
CRON_SECRET=

# ========================
# S3 Storage (MinIO in dev)
# ========================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=ventrix-files
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=true

# ========================
# Email: platform account (MailHog in dev)
# ========================
# Sends account emails (welcome, OTP, password reset), and business emails for businesses that haven't set up
# their own account in Settings → Email. Production with the Ventrix Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=<ventrix gmail>  SMTP_PASS=<16-char App Password>  FROM_EMAIL=<same gmail>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@ventrix.com
FROM_NAME="Ventrix"

# ========================
# SMS (Twilio)
# ========================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ========================
# WhatsApp (Meta Business API)
# ========================
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token

# ========================
# Google OAuth
# ========================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# ========================
# Payment Gateway (Razorpay)
# ========================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ========================
# Encryption
# ========================
# Encrypts each business's own email password at rest. Required for Settings → Email. Min 32 chars:
# openssl rand -hex 32. Changing it later makes saved passwords unreadable (businesses re-enter them).
ENCRYPTION_KEY=

# ========================
# Rate Limiting
# ========================
RATE_LIMIT_WINDOW_MS=900000
# Per signed-in user (per IP when signed out) per window
RATE_LIMIT_MAX_REQUESTS=1000

# ========================
# Bull Queue (Redis)
# ========================
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379
BULL_REDIS_PASSWORD=redis_secret

# ========================
# Logging
# ========================
LOG_LEVEL=debug
LOG_FORMAT=json

# ========================
# Feature Flags
# ========================
FEATURE_MANUFACTURING=true
FEATURE_CRM=true
FEATURE_PAYROLL=false
FEATURE_MULTI_CURRENCY=true
FEATURE_OFFLINE_SYNC=true
# Socket.io real-time push — future feature, keep false for now (free-tier hosting)
FEATURE_REALTIME=false

# ========================
# Frontend (Next.js)
# ========================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME="Ventrix"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
