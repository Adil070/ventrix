}

model SalesOrderItem {
  id            String   @id @default(cuid())
  salesOrderId  String
  productId     String?
  variantId     String?
  description   String
  quantity      Decimal  @db.Decimal(15, 3)
  fulfilledQty  Decimal  @default(0) @db.Decimal(15, 3)
  unit          String?
  unitPrice     Decimal  @db.Decimal(15, 2)
  discount      Decimal  @default(0) @db.Decimal(5, 2)
  taxRate       Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal  @default(0) @db.Decimal(15, 2)
  amount        Decimal  @db.Decimal(15, 2)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@map("sales_order_items")
}

// ============================================================
// INVOICES (BILLING)
// ============================================================

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  branchId        String?
  customerId      String?
  salesOrderId    String?
  invoiceNumber   String
  invoiceType     InvoiceType   @default(GST_INVOICE)
  status          InvoiceStatus @default(DRAFT)
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime?
  supplyDate      DateTime?
  placeOfSupply   String?
  currency        String        @default("INR")
  exchangeRate    Decimal       @default(1) @db.Decimal(15, 6)
  subtotal        Decimal       @default(0) @db.Decimal(15, 2)
  discountType    String?
  discountValue   Decimal       @default(0) @db.Decimal(15, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(15, 2)
  taxableAmount   Decimal       @default(0) @db.Decimal(15, 2)
  cgstAmount      Decimal       @default(0) @db.Decimal(15, 2)
  sgstAmount      Decimal       @default(0) @db.Decimal(15, 2)
  igstAmount      Decimal       @default(0) @db.Decimal(15, 2)
  cessAmount      Decimal       @default(0) @db.Decimal(15, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(15, 2)
  shippingCharges Decimal       @default(0) @db.Decimal(15, 2)
  roundOff        Decimal       @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal       @default(0) @db.Decimal(15, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(15, 2)
  balanceAmount   Decimal       @default(0) @db.Decimal(15, 2)
  termsAndConditions String?
  notes           String?
  signature       String?
  templateId      String?
  billingAddress  Json?
  shippingAddress Json?
  reverseCharge   Boolean       @default(false)
  isExport        Boolean       @default(false)
  exportType      String?
  eInvoiceIRN     String?
  eInvoiceAckNo   String?
  eWayBillNumber  String?
  couponId        String?
  createdBy       String?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch?       @relation(fields: [branchId], references: [id])
  customer        Customer?     @relation(fields: [customerId], references: [id])
  salesOrder      SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]
  journalEntries  JournalEntry[]
  returnOrders    ReturnOrder[]
  documents       Document[]

  @@unique([organizationId, invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id             String    @id @default(cuid())
  invoiceId      String
  productId      String?
  variantId      String?
  taxRateId      String?
  description    String
  hsnCode        String?
  sacCode        String?
  quantity       Decimal   @db.Decimal(15, 3)
  unit           String?
  unitPrice      Decimal   @db.Decimal(15, 2)
  discountType   String?
  discountValue  Decimal   @default(0) @db.Decimal(15, 2)
  discountAmount Decimal   @default(0) @db.Decimal(15, 2)
  taxableAmount  Decimal   @default(0) @db.Decimal(15, 2)
  taxRate        Decimal   @default(0) @db.Decimal(5, 2)
  cgstRate       Decimal   @default(0) @db.Decimal(5, 2)
  sgstRate       Decimal   @default(0) @db.Decimal(5, 2)
  igstRate       Decimal   @default(0) @db.Decimal(5, 2)
  cgstAmount     Decimal   @default(0) @db.Decimal(15, 2)
  sgstAmount     Decimal   @default(0) @db.Decimal(15, 2)
  igstAmount     Decimal   @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(15, 2)
  amount         Decimal   @db.Decimal(15, 2)
  batchNumber    String?
  serialNumbers  String[]
  sortOrder      Int       @default(0)
  warehouseId    String?
  createdAt      DateTime  @default(now())

  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product?  @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  taxRate_       TaxRate?  @relation(fields: [taxRateId], references: [id])

  @@map("invoice_items")
}

// ============================================================
// DELIVERY CHALLAN
// ============================================================

model DeliveryChallan {
  id              String                @id @default(cuid())
  organizationId  String
  salesOrderId    String?
  challanNumber   String
  status          DeliveryChallanStatus @default(DRAFT)
  challanDate     DateTime              @default(now())
  customerId      String?
  vehicleNumber   String?
  transporterName String?
  notes           String?
  createdBy       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder      SalesOrder?           @relation(fields: [salesOrderId], references: [id])
  items           DeliveryChallanItem[]

  @@unique([organizationId, challanNumber])
  @@map("delivery_challans")
}

model DeliveryChallanItem {
  id           String   @id @default(cuid())
  challanId    String
  productId    String?
  description  String
  quantity     Decimal  @db.Decimal(15, 3)
  unit         String?
  createdAt    DateTime @default(now())

  challan      DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)

  @@map("delivery_challan_items")
}

// ============================================================
// PURCHASES
// ============================================================

model Purchase {
  id              String              @id @default(cuid())
  organizationId  String
  branchId        String?
  supplierId      String?
  purchaseNumber  String
  billNumber      String?
  type            String              @default("BILL")
  status          PurchaseOrderStatus @default(DRAFT)
  purchaseDate    DateTime            @default(now())
  dueDate         DateTime?
  currency        String              @default("INR")
  subtotal        Decimal             @default(0) @db.Decimal(15, 2)
  discountAmount  Decimal             @default(0) @db.Decimal(15, 2)
  taxableAmount   Decimal             @default(0) @db.Decimal(15, 2)
  cgstAmount      Decimal             @default(0) @db.Decimal(15, 2)
  sgstAmount      Decimal             @default(0) @db.Decimal(15, 2)
  igstAmount      Decimal             @default(0) @db.Decimal(15, 2)
  taxAmount       Decimal             @default(0) @db.Decimal(15, 2)
  shippingCharges Decimal             @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal             @default(0) @db.Decimal(15, 2)
  paidAmount      Decimal             @default(0) @db.Decimal(15, 2)
  balanceAmount   Decimal             @default(0) @db.Decimal(15, 2)
  termsAndConditions String?
  notes           String?
  reverseCharge   Boolean             @default(false)
  warehouseId     String?
  createdBy       String?
  approvedBy      String?
  approvedAt      DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch?       @relation(fields: [branchId], references: [id])
  supplier        Supplier?     @relation(fields: [supplierId], references: [id])
  items           PurchaseItem[]
  payments        Payment[]
  journalEntries  JournalEntry[]
  returnOrders    ReturnOrder[]
  documents       Document[]

  @@unique([organizationId, purchaseNumber])
  @@map("purchases")
}

model PurchaseItem {
  id             String    @id @default(cuid())
  purchaseId     String
  productId      String?
  variantId      String?
  taxRateId      String?
  description    String
  hsnCode        String?
  quantity       Decimal   @db.Decimal(15, 3)
  unit           String?
  unitPrice      Decimal   @db.Decimal(15, 2)
  discountAmount Decimal   @default(0) @db.Decimal(15, 2)
  taxableAmount  Decimal   @default(0) @db.Decimal(15, 2)
  taxRate        Decimal   @default(0) @db.Decimal(5, 2)
  cgstRate       Decimal   @default(0) @db.Decimal(5, 2)
  sgstRate       Decimal   @default(0) @db.Decimal(5, 2)
  igstRate       Decimal   @default(0) @db.Decimal(5, 2)
  cgstAmount     Decimal   @default(0) @db.Decimal(15, 2)
  sgstAmount     Decimal   @default(0) @db.Decimal(15, 2)
  igstAmount     Decimal   @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(15, 2)
  amount         Decimal   @db.Decimal(15, 2)
  batchNumber    String?
  warehouseId    String?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())

  purchase       Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product        Product?  @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  taxRate_       TaxRate?  @relation(fields: [taxRateId], references: [id])

  @@map("purchase_items")
}

// ============================================================
// RETURN ORDERS (SALES & PURCHASE RETURNS)
// ============================================================

model ReturnOrder {
  id              String      @id @default(cuid())
  organizationId  String
  invoiceId       String?
  purchaseId      String?
  customerId      String?
  supplierId      String?
  returnNumber    String
  returnType      ReturnType
  returnDate      DateTime    @default(now())
  status          String      @default("DRAFT")
  totalAmount     Decimal     @default(0) @db.Decimal(15, 2)
  refundAmount    Decimal     @default(0) @db.Decimal(15, 2)
  reason          String?
  notes           String?
  createdBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice         Invoice?        @relation(fields: [invoiceId], references: [id])
  purchase        Purchase?       @relation(fields: [purchaseId], references: [id])
  customer        Customer?       @relation(fields: [customerId], references: [id])
  supplier        Supplier?       @relation(fields: [supplierId], references: [id])
  items           ReturnOrderItem[]
  creditDebitNotes CreditDebitNote[]

  @@unique([organizationId, returnNumber])
  @@map("return_orders")
}

model ReturnOrderItem {
  id            String   @id @default(cuid())
  returnOrderId String
  productId     String?
  description   String
  quantity      Decimal  @db.Decimal(15, 3)
  unitPrice     Decimal  @db.Decimal(15, 2)
  taxAmount     Decimal  @default(0) @db.Decimal(15, 2)
  amount        Decimal  @db.Decimal(15, 2)
  createdAt     DateTime @default(now())

  returnOrder   ReturnOrder @relation(fields: [returnOrderId], references: [id], onDelete: Cascade)
  product       Product?    @relation(fields: [productId], references: [id])

  @@map("return_order_items")
}

model CreditDebitNote {
  id            String    @id @default(cuid())
  returnOrderId String
  noteNumber    String
  type          String
  amount        Decimal   @db.Decimal(15, 2)
  adjustedAmount Decimal  @default(0) @db.Decimal(15, 2)
  status        String    @default("OPEN")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  returnOrder   ReturnOrder @relation(fields: [returnOrderId], references: [id], onDelete: Cascade)

  @@map("credit_debit_notes")
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id              String        @id @default(cuid())
  organizationId  String?
  invoiceId       String?
  purchaseId      String?
  customerId      String?
  supplierId      String?
  paymentNumber   String
  type            String
  mode            PaymentMode   @default(CASH)
  status          PaymentStatus @default(COMPLETED)
  amount          Decimal       @db.Decimal(15, 2)
  currency        String        @default("INR")
  exchangeRate    Decimal       @default(1) @db.Decimal(15, 6)
  paymentDate     DateTime      @default(now())
  referenceNumber String?
  bankAccountId   String?
  transactionId   String?
  upiId           String?
  notes           String?
  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])
  purchase        Purchase?     @relation(fields: [purchaseId], references: [id])
  customer        Customer?     @relation("CustomerPayments", fields: [customerId], references: [id])
  supplier        Supplier?     @relation("SupplierPayments", fields: [supplierId], references: [id])
  bankAccount     BankAccount?  @relation(fields: [bankAccountId], references: [id])
  journalEntries  JournalEntry[]

  @@map("payments")
}

// ============================================================
// ACCOUNTING - CHART OF ACCOUNTS, JOURNAL ENTRIES
// ============================================================

model Account {
  id             String         @id @default(cuid())
  organizationId String
  parentId       String?
  code           String
  name           String
  type           AccountType
  subType        AccountSubType?
  description    String?
  currency       String         @default("INR")
  openingBalance Decimal        @default(0) @db.Decimal(15, 2)
  isSystem       Boolean        @default(false)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Account?       @relation("AccountChildren", fields: [parentId], references: [id])
  children       Account[]      @relation("AccountChildren")
  debitLines     JournalEntryLine[] @relation("DebitAccount")
  creditLines    JournalEntryLine[] @relation("CreditAccount")
  bankAccounts   BankAccount[]
  costCenters    CostCenter[]

  @@unique([organizationId, code])
  @@map("accounts")
}

model CostCenter {
  id             String   @id @default(cuid())
  organizationId String
  accountId      String?
  name           String
  code           String?
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        Account?     @relation(fields: [accountId], references: [id])
  journalLines   JournalEntryLine[]

  @@map("cost_centers")
}

model JournalEntry {
  id             String           @id @default(cuid())
  organizationId String?
  entryNumber    String
  type           JournalEntryType @default(JOURNAL)
  referenceType  String?
  referenceId    String?
  invoiceId      String?
  purchaseId     String?
  paymentId      String?
  date           DateTime         @default(now())
  description    String?
  totalDebit     Decimal          @default(0) @db.Decimal(15, 2)
  totalCredit    Decimal          @default(0) @db.Decimal(15, 2)
  isPosted       Boolean          @default(false)
  postedAt       DateTime?
  createdBy      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  invoice        Invoice?         @relation(fields: [invoiceId], references: [id])
  purchase       Purchase?        @relation(fields: [purchaseId], references: [id])
  payment        Payment?         @relation(fields: [paymentId], references: [id])
  lines          JournalEntryLine[]

  @@map("journal_entries")
}

model JournalEntryLine {
  id             String    @id @default(cuid())
  journalEntryId String
  accountId      String
  debitAccountId  String?
  creditAccountId String?
  costCenterId   String?
  description    String?
  debitAmount    Decimal   @default(0) @db.Decimal(15, 2)
  creditAmount   Decimal   @default(0) @db.Decimal(15, 2)
  currency       String    @default("INR")
  exchangeRate   Decimal   @default(1) @db.Decimal(15, 6)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation("DebitAccount", fields: [accountId], references: [id], map: "jel_debit_account_fkey")
  debitAccount   Account?     @relation("CreditAccount", fields: [debitAccountId], references: [id], map: "jel_credit_account_fkey")
  costCenter     CostCenter?  @relation(fields: [costCenterId], references: [id])

  @@map("journal_entry_lines")
}

// ============================================================
// BANKING
// ============================================================

model BankAccount {
  id              String   @id @default(cuid())
  organizationId  String?
  accountId       String?
  accountName     String
  bankName        String
  accountNumber   String
  ifscCode        String?
  branchName      String?
  accountType     String   @default("SAVINGS")
  currency        String   @default("INR")
  openingBalance  Decimal  @default(0) @db.Decimal(15, 2)
  currentBalance  Decimal  @default(0) @db.Decimal(15, 2)
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account         Account?      @relation(fields: [accountId], references: [id])
  transactions    BankTransaction[]
  payments        Payment[]

  @@map("bank_accounts")
}

model BankTransaction {
  id              String              @id @default(cuid())
  bankAccountId   String
  transactionDate DateTime
  type            BankTransactionType
  amount          Decimal             @db.Decimal(15, 2)
  description     String?
  referenceNumber String?
  isReconciled    Boolean             @default(false)
  reconciledAt    DateTime?
  matchedPaymentId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@map("bank_transactions")
}

// ============================================================
// EXPENSES
// ============================================================

model ExpenseCategory {
  id             String    @id @default(cuid())
  parentId       String?
  name           String
  description    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  parent         ExpenseCategory?  @relation("ExpenseCategoryChildren", fields: [parentId], references: [id])
  children       ExpenseCategory[] @relation("ExpenseCategoryChildren")
  expenses       Expense[]

  @@map("expense_categories")
}

model Expense {
  id             String        @id @default(cuid())
  organizationId String
  branchId       String?
  categoryId     String?
  expenseNumber  String
  title          String
  description    String?
  amount         Decimal       @db.Decimal(15, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal       @db.Decimal(15, 2)
  currency       String        @default("INR")
  expenseDate    DateTime      @default(now())
  paymentMode    PaymentMode   @default(CASH)
  bankAccountId  String?
  status         ExpenseStatus @default(PENDING)
  paidBy         String?
  approvedBy     String?
  approvedAt     DateTime?
  receipts       String[]
  isRecurring    Boolean       @default(false)
  recurringConfig Json?
  notes          String?
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?          @relation(fields: [branchId], references: [id])
  category       ExpenseCategory? @relation(fields: [categoryId], references: [id])

  @@unique([organizationId, expenseNumber])
  @@map("expenses")
}

// ============================================================
// CRM
// ============================================================

model Lead {
  id             String     @id @default(cuid())
  organizationId String
  customerId     String?
  assignedTo     String?
  name           String
  email          String?
  phone          String?
  company        String?
  source         String?
  status         LeadStatus @default(NEW)
  priority       TaskPriority @default(MEDIUM)
  expectedValue  Decimal?   @db.Decimal(15, 2)
  expectedCloseDate DateTime?
  notes          String?
  tags           String[]
  lostReason     String?
  convertedAt    DateTime?
  createdBy      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?    @relation(fields: [customerId], references: [id])
  activities     LeadActivity[]
  tasks          Task[]

  @@map("leads")
}

model LeadActivity {
  id          String   @id @default(cuid())
  leadId      String
  type        String
  title       String
  description String?
  metadata    Json?
  createdBy   String?
  createdAt   DateTime @default(now())

  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_activities")
}

model Task {
  id             String       @id @default(cuid())
  organizationId String?
  leadId         String?
  assignedToId   String?
  createdById    String?
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  completedAt    DateTime?
  relatedType    String?
  relatedId      String?
  tags           String[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lead           Lead?        @relation(fields: [leadId], references: [id])
  assignedTo     User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id])

  @@map("tasks")
}

// ============================================================
// MANUFACTURING
// ============================================================

model BillOfMaterial {
  id             String    @id @default(cuid())
  organizationId String?
  productId      String
  name           String
  version        String    @default("1.0")
  quantity       Decimal   @db.Decimal(15, 3)
  unit           String?
  isActive       Boolean   @default(true)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product        Product   @relation("BOMProduct", fields: [productId], references: [id])
  components     BOMComponent[]
  productionOrders ProductionOrder[]

  @@map("bill_of_materials")
}

model BOMComponent {
  id             String   @id @default(cuid())
  bomId          String
  productId      String
  quantity       Decimal  @db.Decimal(15, 3)
  unit           String?
  scrapPercent   Decimal  @default(0) @db.Decimal(5, 2)
  notes          String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  bom            BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product        Product        @relation("BOMComponent", fields: [productId], references: [id])

  @@map("bom_components")
}

model ProductionOrder {
  id              String                @id @default(cuid())
  organizationId  String?
  bomId           String?
  warehouseId     String?
  orderNumber     String
  status          ProductionOrderStatus @default(DRAFT)
  plannedStartDate DateTime?
  plannedEndDate  DateTime?
  actualStartDate DateTime?
  actualEndDate   DateTime?
  plannedQuantity Decimal               @db.Decimal(15, 3)
  producedQuantity Decimal              @default(0) @db.Decimal(15, 3)
  notes           String?
  createdBy       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organization    Organization?         @relation(fields: [organizationId], references: [id])
  bom             BillOfMaterial?       @relation(fields: [bomId], references: [id])
  warehouse       Warehouse?            @relation(fields: [warehouseId], references: [id])
  materialIssues  MaterialIssue[]

  @@map("production_orders")
}

model MaterialIssue {
  id                String   @id @default(cuid())
  productionOrderId String
  productId         String
  quantity          Decimal  @db.Decimal(15, 3)
  issuedAt          DateTime @default(now())
  issuedBy          String?
  notes             String?

  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@map("material_issues")
}

// ============================================================
// EMPLOYEES
// ============================================================

model Employee {
  id              String    @id @default(cuid())
  organizationId  String?
  userId          String?   @unique
  employeeCode    String
  firstName       String
  lastName        String
  email           String?
  phone           String?
  designation     String?
  department      String?
  joiningDate     DateTime?
  salary          Decimal?  @db.Decimal(15, 2)
  salaryType      String?
  bankDetails     Json?
  address         Json?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id])
  attendance      EmployeeAttendance[]
  salaryRecords   SalaryRecord[]

  @@map("employees")
}

model EmployeeAttendance {
  id          String           @id @default(cuid())
  employeeId  String
  date        DateTime         @db.Date
  status      AttendanceStatus @default(PRESENT)
  checkIn     DateTime?
  checkOut    DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("employee_attendance")
}

model SalaryRecord {
  id          String   @id @default(cuid())
  employeeId  String
  month       Int
  year        Int
  basicSalary Decimal  @db.Decimal(15, 2)
  allowances  Decimal  @default(0) @db.Decimal(15, 2)
  deductions  Decimal  @default(0) @db.Decimal(15, 2)
  netSalary   Decimal  @db.Decimal(15, 2)
  isPaid      Boolean  @default(false)
  paidOn      DateTime?
  paymentMode PaymentMode?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@map("salary_records")
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id             String       @id @default(cuid())
  organizationId String
  invoiceId      String?
  purchaseId     String?
  type           DocumentType @default(ATTACHMENT)
  name           String
  fileName       String
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  version        Int          @default(1)
  isPublic       Boolean      @default(false)
  uploadedBy     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id])
  purchase       Purchase?    @relation(fields: [purchaseId], references: [id])

  @@map("documents")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id             String           @id @default(cuid())
  organizationId String?
  userId         String
  type           NotificationType @default(IN_APP)
  title          String
  body           String
  metadata       Json?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  sentAt         DateTime?
  createdAt      DateTime         @default(now())

  organization   Organization?    @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ============================================================
// AUDIT & ACTIVITY LOGS
// ============================================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  module         String
  resourceType   String?
  resourceId     String?
  oldValues      Json?
  newValues      Json?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  description    String
  module         String?
  resourceType   String?
  resourceId     String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

// ============================================================
// PRICING
// ============================================================

model PriceList {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  currency       String    @default("INR")
  discountType   String?
  discountValue  Decimal   @default(0) @db.Decimal(5, 2)
  isDefault      Boolean   @default(false)
  isActive       Boolean   @default(true)
  validFrom      DateTime?
  validUntil     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          PriceListItem[]
  customers      Customer[]

  @@map("price_lists")
}

model PriceListItem {
  id          String   @id @default(cuid())
  priceListId String
  productId   String
  variantId   String?
  price       Decimal  @db.Decimal(15, 2)
  minQuantity Decimal? @db.Decimal(15, 3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@map("price_list_items")
}

model Coupon {
  id             String    @id @default(cuid())
  organizationId String
  code           String
  description    String?
  discountType   String
  discountValue  Decimal   @db.Decimal(15, 2)
  minOrderAmount Decimal?  @db.Decimal(15, 2)
  maxDiscount    Decimal?  @db.Decimal(15, 2)
  usageLimit     Int?
  usedCount      Int       @default(0)
  validFrom      DateTime?
  validUntil     DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices       Invoice[]

  @@unique([organizationId, code])
  @@map("coupons")
}

model PaymentTerm {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  days           Int
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("payment_terms")
}
