// ============================================================
// Ventrix - Complete Prisma Schema
// Enterprise-grade Multi-tenant SaaS ERP Platform
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex", "multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ORG_OWNER
  BRANCH_ADMIN
  ACCOUNTANT
  MANAGER
  SALES_EXECUTIVE
  CASHIER
  WAREHOUSE_MANAGER
  STAFF
}

enum Permission {
  VIEW
  CREATE
  EDIT
  DELETE
  EXPORT
  PRINT
  APPROVE
  MANAGE_USERS
  MANAGE_SETTINGS
}

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  TRIAL
  EXPIRED
  CANCELLED
}

enum InvoiceType {
  GST_INVOICE
  TAX_INVOICE
  RETAIL_INVOICE
  WHOLESALE_INVOICE
  POS_INVOICE
  PROFORMA_INVOICE
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_PAID
  PAID
  CANCELLED
  OVERDUE
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  BILLED
}

enum PaymentMode {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CHEQUE
  WALLET
  CREDIT
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIAL
}

enum StockMovementType {
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  OPENING_STOCK
  PRODUCTION_IN
  PRODUCTION_OUT
  DAMAGE
  EXPIRED
}

enum ValuationMethod {
  FIFO
  LIFO
  WEIGHTED_AVERAGE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountSubType {
  CURRENT_ASSET
  FIXED_ASSET
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  CAPITAL
  RETAINED_EARNINGS
  OPERATING_REVENUE
  OTHER_REVENUE
  COST_OF_GOODS_SOLD
  OPERATING_EXPENSE
  DEPRECIATION
  TAX
  BANK
  CASH
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
}

enum JournalEntryType {
  SALES
  PURCHASE
  PAYMENT
  RECEIPT
  JOURNAL
  CONTRA
  DEBIT_NOTE
  CREDIT_NOTE
  OPENING_BALANCE
  CLOSING_BALANCE
}

enum GSTType {
  CGST
  SGST
  IGST
  CESS
  EXEMPTED
  NIL_RATED
  NON_GST
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  INACTIVE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum DocumentType {
  INVOICE
  BILL
  RECEIPT
  QUOTATION
  PURCHASE_ORDER
  DELIVERY_CHALLAN
  CONTRACT
  ATTACHMENT
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum ProductionOrderStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
  WORK_FROM_HOME
}

enum BankTransactionType {
  CREDIT
  DEBIT
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  INVOICED
}

enum ReturnType {
  SALES_RETURN
  PURCHASE_RETURN
}

enum DeliveryChallanStatus {
  DRAFT
  ISSUED
  DELIVERED
  RETURNED
  CANCELLED
}

// ============================================================
// MULTI-TENANCY: Organizations & Branches
// ============================================================

model Organization {
  id                 String             @id @default(cuid())
  name               String
  legalName          String?
  gstin              String?
  pan                String?
  cin                String?
  tan                String?
  msmeNumber         String?
  registrationNumber String?
  businessType       String?
  industry           String?
  email              String?
  phone              String?
  website            String?
  logoUrl            String?
  signatureUrl       String?
  address            Json?
  billingAddress     Json?
  bankDetails        Json?
  invoicePrefix      String             @default("INV")
  purchasePrefix     String             @default("PUR")
  quotationPrefix    String             @default("QUO")
  salesOrderPrefix   String             @default("SO")
  currency           String             @default("INR")
  timezone           String             @default("Asia/Kolkata")
  financialYearStart Int                @default(4)
  isActive           Boolean            @default(true)
  settings           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  branches           Branch[]
  users              UserOrganization[]
  subscription       Subscription?
  customers          Customer[]
  suppliers          Supplier[]
  products           Product[]
  invoices           Invoice[]
  purchases          Purchase[]
  accounts           Account[]
  expenses           Expense[]
  leads              Lead[]
  employees          Employee[]
  warehouses         Warehouse[]
  bankAccounts       BankAccount[]
  documents          Document[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  featureFlags       FeatureFlag[]
  taxRates           TaxRate[]
  hsnCodes           HSNCode[]
  paymentTerms       PaymentTerm[]
  productCategories  ProductCategory[]
  units              Unit[]
  brands             Brand[]
  costCenters        CostCenter[]
  priceList          PriceList[]
  coupons            Coupon[]
  activityLogs       ActivityLog[]
  salesOrders        SalesOrder[]
  quotations         Quotation[]
  deliveryChallan    DeliveryChallan[]
  returnOrders       ReturnOrder[]
  productionOrders   ProductionOrder[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  gstin          String?
  email          String?
  phone          String?
  address        Json?
  isHeadOffice   Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          UserOrganization[]
  invoices       Invoice[]
  purchases      Purchase[]
  warehouses     Warehouse[]
  expenses       Expense[]
  salesOrders    SalesOrder[]
  quotations     Quotation[]

  @@unique([organizationId, code])
  @@map("branches")
}

// ============================================================
// USERS & AUTHENTICATION
// ============================================================

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  phone                 String?  @unique
  firstName             String
  lastName              String
  passwordHash          String?
  avatarUrl             String?
  isEmailVerified       Boolean  @default(false)
  isPhoneVerified       Boolean  @default(false)
  isSuperAdmin          Boolean  @default(false)
  isActive              Boolean  @default(true)
  lastLoginAt           DateTime?
  lastLoginIp           String?
  failedLoginAttempts   Int      @default(0)
  lockedUntil           DateTime?
  preferences           Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organizations         UserOrganization[]
  refreshTokens         RefreshToken[]
  otpCodes              OTPCode[]
  sessions              UserSession[]
  devices               UserDevice[]
  auditLogs             AuditLog[]
  activityLogs          ActivityLog[]
  assignedTasks         Task[]             @relation("TaskAssignee")
  createdTasks          Task[]             @relation("TaskCreator")
  notifications         Notification[]
  employeeProfile       Employee?

  @@map("users")
}

model UserOrganization {
  id             String     @id @default(cuid())
  userId         String
  organizationId String
  branchId       String?
  role           UserRole   @default(STAFF)
  customRole     String?
  isActive       Boolean    @default(true)
  joinedAt       DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?      @relation(fields: [branchId], references: [id])
  permissions    RolePermission[]

  @@unique([userId, organizationId])
  @@map("user_organizations")
}

model RolePermission {
  id                 String     @id @default(cuid())
  userOrganizationId String
  module             String
  permissions        Permission[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  userOrganization   UserOrganization @relation(fields: [userOrganizationId], references: [id], onDelete: Cascade)

  @@unique([userOrganizationId, module])
  @@map("role_permissions")
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  isRevoked   Boolean  @default(false)
  deviceInfo  Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model OTPCode {
  id          String   @id @default(cuid())
  userId      String?
  identifier  String
  code        String
  type        String
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}

model UserSession {
  id          String   @id @default(cuid())
  userId      String
  sessionToken String  @unique
  deviceInfo  Json?
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  lastActiveAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model UserDevice {
  id           String   @id @default(cuid())
  userId       String
  deviceId     String
  deviceName   String?
  deviceType   String?
  fcmToken     String?
  isActive     Boolean  @default(true)
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("user_devices")
}

// ============================================================
// SUBSCRIPTIONS & PLANS
// ============================================================

model Subscription {
  id              String             @id @default(cuid())
  organizationId  String             @unique
  plan            SubscriptionPlan   @default(FREE)
  status          SubscriptionStatus @default(TRIAL)
  trialEndsAt     DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean        @default(false)
  cancelledAt     DateTime?
  gatewayCustomerId  String?
  gatewaySubId    String?
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices        SubscriptionInvoice[]
  usageRecords    UsageRecord[]

  @@map("subscriptions")
}

model SubscriptionInvoice {
  id              String   @id @default(cuid())
  subscriptionId  String
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("INR")
  status          String
  dueDate         DateTime?
  paidAt          DateTime?
  gatewayInvoiceId String?
  metadata        Json?
  createdAt       DateTime @default(now())

  subscription    Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("subscription_invoices")
}

model UsageRecord {
  id              String   @id @default(cuid())
  subscriptionId  String
  metric          String
  quantity        Int
  recordedAt      DateTime @default(now())

  subscription    Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("usage_records")
}

model FeatureFlag {
  id              String       @id @default(cuid())
  organizationId  String?
  key             String
  enabled         Boolean      @default(true)
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("feature_flags")
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id              String    @id @default(cuid())
  organizationId  String
  code            String?
  name            String
  displayName     String?
  email           String?
  phone           String?
  altPhone        String?
  gstin           String?
  pan             String?
  creditLimit     Decimal   @default(0) @db.Decimal(15, 2)
  creditDays      Int       @default(0)
  openingBalance  Decimal   @default(0) @db.Decimal(15, 2)
  openingBalanceType TransactionType @default(DEBIT)
  currency        String    @default("INR")
  priceListId     String?
  billingAddress  Json?
  shippingAddress Json?
  notes           String?
  tags            String[]
  groupId         String?
  referredBy      String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group           CustomerGroup? @relation(fields: [groupId], references: [id])
  priceList       PriceList?     @relation(fields: [priceListId], references: [id])
  invoices        Invoice[]
  receipts        Payment[]      @relation("CustomerPayments")
  leads           Lead[]
  activities      CustomerActivity[]
  contacts        CustomerContact[]
  salesOrders     SalesOrder[]
  quotations      Quotation[]
  returnOrders    ReturnOrder[]

  @@unique([organizationId, code])
  @@map("customers")
}

model CustomerGroup {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  discount       Decimal  @default(0) @db.Decimal(5, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customers      Customer[]

  @@map("customer_groups")
}

model CustomerContact {
  id          String   @id @default(cuid())
  customerId  String
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_contacts")
}

model CustomerActivity {
  id          String   @id @default(cuid())
  customerId  String
  type        String
  title       String
  description String?
  metadata    Json?
  createdBy   String?
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_activities")
}

// ============================================================
// SUPPLIERS
// ============================================================

model Supplier {
  id              String    @id @default(cuid())
  organizationId  String
  code            String?
  name            String
  displayName     String?
  email           String?
  phone           String?
  altPhone        String?
  gstin           String?
  pan             String?
  openingBalance  Decimal   @default(0) @db.Decimal(15, 2)
  openingBalanceType TransactionType @default(CREDIT)
  currency        String    @default("INR")
  paymentTerms    Int       @default(30)
  billingAddress  Json?
  shippingAddress Json?
  bankDetails     Json?
  notes           String?
  tags            String[]
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchases       Purchase[]
  payments        Payment[]    @relation("SupplierPayments")
  contacts        SupplierContact[]
  returnOrders    ReturnOrder[]

  @@unique([organizationId, code])
  @@map("suppliers")
}

model SupplierContact {
  id          String   @id @default(cuid())
  supplierId  String
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_contacts")
}

// ============================================================
// PRODUCTS & INVENTORY
// ============================================================

model ProductCategory {
  id             String    @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  description    String?
  imageUrl       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         ProductCategory?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children       ProductCategory[] @relation("CategoryChildren")
  products       Product[]

  @@map("product_categories")
}

model Brand {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  logoUrl        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@map("brands")
}

model Unit {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  abbreviation   String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]
  productVariants ProductVariant[]

  @@unique([organizationId, abbreviation])
  @@map("units")
}

model Product {
  id                String          @id @default(cuid())
  organizationId    String
  categoryId        String?
  brandId           String?
  unitId            String?
  name              String
  description       String?
  sku               String?
  barcode           String?
  hsnCode           String?
  sacCode           String?
  type              String          @default("PRODUCT")
  imageUrl          String?
  images            String[]
  sellingPrice      Decimal         @default(0) @db.Decimal(15, 2)
  costPrice         Decimal         @default(0) @db.Decimal(15, 2)
  mrp               Decimal         @default(0) @db.Decimal(15, 2)
  wholesalePrice    Decimal         @default(0) @db.Decimal(15, 2)
  taxRate           Decimal         @default(0) @db.Decimal(5, 2)
  taxRateId         String?
  isTaxInclusive    Boolean         @default(false)
  hasVariants       Boolean         @default(false)
  trackInventory    Boolean         @default(true)
  hasBatchTracking  Boolean         @default(false)
  hasSerialTracking Boolean         @default(false)
  minStockLevel     Decimal         @default(0) @db.Decimal(15, 3)
  maxStockLevel     Decimal         @default(0) @db.Decimal(15, 3)
  reorderPoint      Decimal         @default(0) @db.Decimal(15, 3)
  openingStock      Decimal         @default(0) @db.Decimal(15, 3)
  valuationMethod   ValuationMethod @default(FIFO)
  attributes        Json?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category          ProductCategory?  @relation(fields: [categoryId], references: [id])
  brand             Brand?            @relation(fields: [brandId], references: [id])
  unit              Unit?             @relation(fields: [unitId], references: [id])
  taxRateRef        TaxRate?          @relation(fields: [taxRateId], references: [id])
  variants          ProductVariant[]
  stockEntries      StockEntry[]
  invoiceItems      InvoiceItem[]
  purchaseItems     PurchaseItem[]
  batchLots         BatchLot[]
  boms              BillOfMaterial[]  @relation("BOMProduct")
  bomComponents     BOMComponent[]    @relation("BOMComponent")
  priceListItems    PriceListItem[]
  returnItems       ReturnOrderItem[]

  @@unique([organizationId, sku])
  @@map("products")
}

model ProductVariant {
  id             String    @id @default(cuid())
  productId      String
  unitId         String?
  name           String
  sku            String?
  barcode        String?
  attributes     Json?
  sellingPrice   Decimal   @default(0) @db.Decimal(15, 2)
  costPrice      Decimal   @default(0) @db.Decimal(15, 2)
  mrp            Decimal   @default(0) @db.Decimal(15, 2)
  imageUrl       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit           Unit?     @relation(fields: [unitId], references: [id])
  stockEntries   StockEntry[]
  invoiceItems   InvoiceItem[]
  purchaseItems  PurchaseItem[]

  @@map("product_variants")
}

model BatchLot {
  id              String    @id @default(cuid())
  productId       String
  warehouseId     String?
  batchNumber     String
  lotNumber       String?
  manufacturingDate DateTime?
  expiryDate      DateTime?
  quantity        Decimal   @default(0) @db.Decimal(15, 3)
  costPrice       Decimal   @default(0) @db.Decimal(15, 2)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id])
  stockEntries    StockEntry[]

  @@map("batch_lots")
}

model SerialNumber {
  id          String    @id @default(cuid())
  productId   String
  warehouseId String?
  serialNo    String
  status      String    @default("IN_STOCK")
  invoiceItemId String?
  purchaseItemId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("serial_numbers")
}

// ============================================================
// WAREHOUSES & INVENTORY
// ============================================================

model Warehouse {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  name           String
  code           String?
  address        Json?
  contactPerson  String?
  phone          String?
  isActive       Boolean   @default(true)
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?       @relation(fields: [branchId], references: [id])
  locations      WarehouseLocation[]
  stockEntries   StockEntry[]
  batchLots      BatchLot[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")
  productionOrders ProductionOrder[]

  @@unique([organizationId, code])
  @@map("warehouses")
}

model WarehouseLocation {
  id          String   @id @default(cuid())
  warehouseId String
  name        String
  code        String?
  row         String?
  rack        String?
  bin         String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockEntries StockEntry[]

  @@map("warehouse_locations")
}

model StockEntry {
  id              String            @id @default(cuid())
  organizationId  String?
  warehouseId     String
  locationId      String?
  productId       String
  variantId       String?
  batchLotId      String?
  serialNumber    String?
  movementType    StockMovementType
  quantity        Decimal           @db.Decimal(15, 3)
  rate            Decimal           @db.Decimal(15, 2)
  amount          Decimal           @db.Decimal(15, 2)
  referenceType   String?
  referenceId     String?
  notes           String?
  createdBy       String?
  createdAt       DateTime          @default(now())

  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id])
  location        WarehouseLocation? @relation(fields: [locationId], references: [id])
  product         Product           @relation(fields: [productId], references: [id])
  variant         ProductVariant?   @relation(fields: [variantId], references: [id])
  batchLot        BatchLot?         @relation(fields: [batchLotId], references: [id])

  @@map("stock_entries")
}

model StockTransfer {
